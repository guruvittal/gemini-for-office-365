# ==============================================================================
# Microsoft Entra ID (Azure AD) SSO Authentication Configuration
# ==============================================================================

# Application (client) ID from your Microsoft Entra App Registration
# Example: dc1eb951-0ad7-4147-9af6-5d7c7f853447
MICROSOFT_ENTRA_APP_ID=YOUR_MICROSOFT_ENTRA_CLIENT_ID

# Set to true to strictly require and validate Entra ID Bearer tokens on all requests.
# Set to false during local development/initial spin-up to bypass token enforcement.
REQUIRE_ENTRA_AUTH=true

# Microsoft JWKS public key endpoint (defaults to common discovery URL if omitted)
ENTRA_JWKS_URL=https://login.microsoftonline.com/common/discovery/v2.0/keys

# Downstream Gemini / StreamAssist Backend Cloud Run URL (Option B Decoupled Proxy)
# Example: https://askgemini-proxy-16933400417.us-central1.run.app
DOWNSTREAM_BACKEND_URL=https://YOUR_GEMINI_PROXY_CLOUD_RUN_URL

# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=8080
LOG_LEVEL=INFO
VERBOSE_LOGGING=false

