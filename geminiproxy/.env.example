# Google Cloud & Vertex AI Configuration
GCP_PROJECT_ID=your-google-cloud-project-id
GCP_REGION=us-central1

# Vertex AI Search & Grounding Datastore (Optional, leave blank if not using Grounding)
# Format: projects/<PROJECT_NUMBER_OR_ID>/locations/global/collections/default_collection/dataStores/<DATASTORE_ID>
VERTEX_DATASTORE_ID=

# Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
PORT=8080
