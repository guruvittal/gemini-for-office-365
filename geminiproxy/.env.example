# Backend Execution Mode: 'streamassist' (Gemini Enterprise) or 'vertexai' (Direct Vertex AI)
BACKEND_MODE=streamassist

# Google Cloud & Vertex AI Configuration
GCP_PROJECT_ID=your-google-cloud-project-id
GCP_REGION=us-central1
GCP_LOCATION=global
STREAM_ASSIST_ENDPOINT_LOCATION=global

# Gemini Enterprise (Discovery Engine / StreamAssist) Configuration
GEMINI_ENTERPRISE_APP_ID=your-gemini-enterprise-app-id
GEMINI_ENTERPRISE_COLLECTION_ID=default_collection
GEMINI_ENTERPRISE_ASSISTANT_ID=default_assistant

# Vertex AI Search & Grounding Datastore (Optional, for Direct Vertex AI Grounding fallback)
VERTEX_DATASTORE_ID=

# Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
PORT=8080

